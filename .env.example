# Public site URL used for Open Graph images, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend (Phase U1+)
# SQLite (default local dev):
DATABASE_PATH=./data/bybelt.db
# Or: DATABASE_URL=file:./data/bybelt.db
#
# --- Production database selection ---
# Preferred: PostgreSQL — set DATABASE_URL (no other flag needed):
#   DATABASE_URL=postgresql://user:password@host:5432/bybelt
#   (run migrations first: `DATABASE_URL=… npm run db:push:pg`)
#
# Explicit single-instance SQLite (sanctioned pilot posture, ≤~100 tenants) —
# set BOTH of these; production refuses to boot on SQLite WITHOUT them
# (no silent fallback):
#   DATABASE_PATH=/app/data/bybelt.db
#   ALLOW_SQLITE_IN_PRODUCTION=true
SESSION_SECRET=change-me-in-production
# SEED_USER_PASSWORD=fashionsis-dev

# Google OAuth (Phase U13 — optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Password reset (Phase U14 — dev shows reset link in API response)
# PASSWORD_RESET_DEBUG=1

# Inbox SSE fan-out across instances (Phase U23 — optional)
# REDIS_URL=redis://127.0.0.1:6379

# Production operations (Phase 18 — optional)
# APP_VERSION reported by GET /api/health (defaults to package version).
# APP_VERSION=0.3.1
# LOG_LEVEL controls the shared structured logger: debug|info|warn|error
# (defaults to info in production, debug otherwise).
# LOG_LEVEL=info

# Email ingest (ported from Ai Helpdesk)
# EMAIL_INGEST_WORKSPACE_ID=
# CRON_SECRET=
# POSTMARK_INBOUND_SECRET=
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=
# IMAP_PASS=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SUPPORT_FROM_EMAIL=
# SUPPORT_FROM_NAME=Support
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://chat.bybelt.com
# BYBELT_INTERNAL_SECRET=shared-with-main-app
# SHOPIFY_PLUGIN_INTERNAL_URL=http://127.0.0.1:3005