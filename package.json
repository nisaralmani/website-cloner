{
  "name": "bybelt-chat",
  "version": "0.3.1",
  "private": true,
  "description": "Bybelt — AI-assisted customer messaging and helpdesk platform",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "bybelt",
    "helpdesk",
    "shopify",
    "nextjs",
    "ai"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "smoke": "npm run build && npm run db:seed && node scripts/smoke-routes.mjs",
    "smoke:ci": "node scripts/smoke-routes.mjs",
    "smoke:api": "npm run build && npm run db:seed && node scripts/smoke-api-tests.mjs",
    "qa:live": "node scripts/live-qa-marketing.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "deploy:shopify:vps": "node scripts/deploy-shopify-chat-vps.mjs",
    "sync:db:vps": "node scripts/sync-db-vps.mjs",
    "sync:helpdesk-env": "node scripts/sync-helpdesk-env.mjs",
    "check:secrets": "node scripts/check-tracked-secrets.mjs",
    "check:no-mock": "node scripts/check-no-mock-runtime.mjs",
    "test:security": "tsx scripts/security-tests.mts",
    "test:jobs": "tsx scripts/test-jobs.mts",
    "test:reliability": "tsx scripts/test-reliability.mts",
    "test:migration": "tsx scripts/test-migration.mts",
    "e2e:critical": "playwright test",
    "e2e:install": "playwright install chromium",
    "smoke:critical": "node scripts/e2e-critical.mjs",
    "smoke:shopify": "node scripts/shopify-stack-smoke.mjs",
    "smoke:shopify-api": "node scripts/shopify-api-smoke.mjs",
    "smoke:shopify-all": "node scripts/shopify-smoke-all.mjs",
    "cron:shopify-sync": "node scripts/shopify-sync-cron.mjs",
    "cron:shopify-reconcile": "node scripts/shopify-reconcile-cron.mjs",
    "cron:shopify-install": "node scripts/install-shopify-cron-vps.mjs",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.postgres.config.ts",
    "db:migrate:pg": "tsx scripts/migrate-sqlite-to-postgres.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.4.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.6.0",
    "mailparser": "^3.9.12",
    "next": "16.2.1",
    "nodemailer": "^9.0.2",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
