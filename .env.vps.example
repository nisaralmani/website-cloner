# Copy to .env.vps (gitignored) — never commit real values.

VPS_IP=your.vps.ip.address
VPS_USER=sysadmin
VPS_SSH_KEY_PATH=C:/Users/you/.ssh/your_key
VPS_REMOTE_WWW_DIR=/var/www/bybelt

# Required for production deploy (same value in main app + Shopify plugin)
SESSION_SECRET=generate-a-long-random-string
BYBELT_INTERNAL_SECRET=generate-another-long-random-string
